<section class="placeholder-page">
  <div class="container">
    <div class="placeholder-card p-4 p-md-5 mx-auto text-center">
      <span class="placeholder-icon mb-4"><i class="bi bi-exclamation-circle" aria-hidden="true"></i></span>
      <p class="eyebrow mb-2">Something went wrong</p>
      <h1 class="h2 fw-bold mb-3">We couldn’t complete that request</h1>
      <p class="text-secondary mb-4"><%= typeof message === 'undefined' ? 'Please try again in a moment.' : message %></p>
      <a class="btn btn-primary" href="/">Return home</a>
    </div>
  </div>
</section>
