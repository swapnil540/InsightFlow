<section class="placeholder-page">
  <div class="container">
    <div class="surface-card import-result-card mx-auto text-center">
      <span class="placeholder-icon mb-4"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
      <p class="eyebrow mb-2">Import complete</p>
      <h1 class="h2 fw-bold mb-3">Your feedback is ready</h1>
      <div class="row g-3 text-start my-4">
        <div class="col-6"><div class="import-stat"><span>Inserted</span><strong><%= insertedCount.toLocaleString() %></strong></div></div>
        <div class="col-6"><div class="import-stat"><span>Skipped</span><strong><%= skippedCount.toLocaleString() %></strong></div></div>
        <div class="col-6"><div class="import-stat"><span>Unique texts analysed</span><strong><%= uniqueTextCount.toLocaleString() %></strong></div></div>
        <div class="col-6"><div class="import-stat"><span>Low-confidence texts</span><strong><%= lowConfidenceCount.toLocaleString() %></strong></div></div>
        <div class="col-12"><div class="import-stat"><span>New analyses created</span><strong><%= newAnalysisCount.toLocaleString() %></strong></div></div>
      </div>
      <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
        <a class="btn btn-primary" href="/feedback?view=all&amp;batch=<%= importBatch %>">View imported rows</a>
        <a class="btn btn-outline-secondary" href="/import">Import another file</a>
      </div>
      <p class="small text-secondary mt-3 mb-0">Import batch: <code><%= importBatch %></code></p>
    </div>
  </div>
</section>
