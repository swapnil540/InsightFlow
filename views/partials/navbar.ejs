<% const links = [
  ['Dashboard', '/dashboard', 'dashboard'], ['Feedback', '/feedback', 'feedback'],
  ['Import', '/import', 'import'], ['Insights', '/insights', 'insights'],
  ['Issues', '/issues', 'issues'], ['Reports', '/reports', 'reports'], ['Adaption', '/adaption', 'adaption'],
]; %>
<nav class="navbar navbar-expand-lg navbar-light app-navbar">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <span class="brand-mark"><i class="bi bi-chat-square-heart-fill" aria-hidden="true"></i></span>
      <span>InsightFlow</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNavbar">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
        <% links.forEach(([label, href, key]) => { const selected = activeNav === key; %>
          <li class="nav-item"><a class="nav-link <%= selected ? 'active' : '' %>" <%= selected ? 'aria-current="page"' : '' %> href="<%= href %>"><%= label %></a></li>
        <% }); %>
      </ul>
    </div>
  </div>
</nav>
